<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron Job to Check Expired Coupons -->
        <record id="cron_check_expired_coupons" model="ir.cron">
            <field name="name">Check Expired Service Coupons</field>
            <field name="model_id" ref="model_service_coupon"/>
            <field name="state">code</field>
            <field name="code">model.check_expired_coupons()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
