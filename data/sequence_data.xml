        <!-- WRC Record Sequence (Generic) -->
        <record id="seq_wrc_record" model="ir.sequence">
            <field name="name">WRC Record</field>
            <field name="code">wrc.record</field>
            <field name="prefix">WRC</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
