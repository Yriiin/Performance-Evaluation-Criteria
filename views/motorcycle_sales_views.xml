<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Delete old view if it exists -->
    <delete model="ir.ui.view" search="[('name', '=', 'motorcycle.sales.form')]"/>
    
    <!-- Root Menu for WRC Management -->
    <menuitem id="menu_wrc_root" name="WRC Management" sequence="10"/>
    
    <!-- Motorcycle Sales List View -->
    <record id="view_motorcycle_sales_tree" model="ir.ui.view">
        <field name="name">motorcycle.sales.tree</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <tree string="Motorcycle Sales">
                <field name="name" string="Sales Order Number"/>
                <field name="partner_id" string="Customer"/>
                <field name="awb_sale_type" string="Sale Type"/>
                <field name="invoice_status" string="Invoice Status"/>
                <field name="wrc_transferred" string="WRC Transferred"/>
                <field name="has_wrc" string="Has WRC Record"/>
                <field name="state" invisible="1"/>
                <field name="is_mc_sale" invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- Motorcycle Sales Form View (standalone with WRC functionality) -->
    <record id="view_motorcycle_sales_form_standalone" model="ir.ui.view">
        <field name="name">motorcycle.sales.form.standalone</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <form string="Motorcycle Sales">
                <header>
                    <button name="action_auto_fill_wrc" type="object" string="Auto-Fill WRC" 
                            class="btn-primary" 
                            attrs="{'invisible': [('show_wrc', '=', False)]}"/>
                    <button name="action_create_wrc_record" type="object" string="Create WRC" 
                            class="btn-secondary" 
                            attrs="{'invisible': ['|', ('show_wrc', '=', False), ('wrc_transferred', '=', True)]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sent,sale"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_wrc" type="object" class="oe_stat_button" icon="fa-id-card"
                                attrs="{'invisible': ['|', ('has_wrc', '=', False), ('show_wrc', '=', False)]}">
                            <field name="wrc_count" widget="statinfo" string="WRC Record"/>
                        </button>
                        <button name="action_view_coupons" type="object" class="oe_stat_button" icon="fa-ticket"
                                attrs="{'invisible': ['|', ('has_wrc', '=', False), ('show_wrc', '=', False)]}">
                            <field name="coupon_count" widget="statinfo" string="Service Coupons"/>
                        </button>
                    </div>
                    
                    <!-- WRC Status Alert -->
                    <div class="alert alert-success" role="alert" 
                         attrs="{'invisible': ['|', ('wrc_transferred', '=', False), ('show_wrc', '=', False)]}">
                        <strong>WRC Record Created:</strong> This motorcycle sale already has a WRC record.
                    </div>
                    
                    <group>
                        <group>
                            <field name="name" string="Order Reference"/>
                            <field name="partner_id"/>
                            <field name="date_order"/>
                            <field name="user_id"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="has_wrc"/>
                            <field name="wrc_transferred"/>
                            <field name="is_mc_sale"/>
                            <field name="show_wrc" invisible="1"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Order Lines">
                            <field name="order_line">
                                <tree>
                                    <field name="product_id"/>
                                    <field name="name"/>
                                    <field name="product_uom_qty"/>
                                    <field name="price_unit"/>
                                    <field name="price_subtotal"/>
                                </tree>
                            </field>
                        </page>
                        
                        <page string="WRC Information" attrs="{'invisible': [('show_wrc', '=', False)]}">
                            <!-- Auto-fill status and controls -->
                            <div class="alert alert-info" role="alert" 
                                 attrs="{'invisible': [('wrc_data_available', '=', False)]}">
                                <strong>Auto-Fill Status:</strong> Delivery data is available for WRC auto-fill.
                                <button name="action_auto_fill_wrc" type="object" class="btn btn-sm btn-primary ml-2">
                                    <i class="fa fa-refresh"/> Refresh Data
                                </button>
                            </div>
                            
                            <!-- Auto-save notification -->
                            <div class="alert alert-success" role="alert" 
                                 attrs="{'invisible': [('wrc_transferred', '=', False)]}">
                                <strong>WRC Auto-Created:</strong> A WRC record has been automatically created for this motorcycle sale.
                            </div>
                            
                            <group>
                                <!-- Customer Profile (Auto-filled, Read-only) -->
                                <group string="Customer Profile">
                                    <field name="wrc_customer_name"/>
                                    <field name="wrc_address"/>
                                    <field name="wrc_phone"/>
                                    <field name="wrc_email"/>
                                    <field name="wrc_birthday"/>
                                </group>
                                
                                <!-- Dealer Profile (Auto-filled, Read-only) -->
                                <group string="Dealer Profile">
                                    <field name="wrc_selling_dealer"/>
                                    <field name="wrc_dealer_code"/>
                                    <field name="wrc_dealer_address"/>
                                </group>
                            </group>

                            <group>
                                <!-- Unit Info (Some fields editable if incomplete) -->
                                <group string="Unit Information">
                                    <field name="wrc_model"/>
                                    <field name="wrc_engine"/>
                                    <field name="wrc_frame"/>
                                    <field name="wrc_purchase_date"/>
                                    <field name="wrc_color"/>
                                    <field name="wrc_brand"/>
                                    <field name="wrc_payment_basis"/>
                                    <field name="wrc_qty"/>
                                    <field name="wrc_classification" widget="selection"/>
                                </group>
                            </group>

                            <!-- Control Fields -->
                            <group>
                                <field name="wrc_auto_filled" invisible="1"/>
                                <field name="wrc_data_available" invisible="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Motorcycle Sales Search View -->
    <record id="view_motorcycle_sales_search" model="ir.ui.view">
        <field name="name">motorcycle.sales.search</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <search string="Motorcycle Sales">
                <field name="name" string="Order Reference"/>
                <field name="company_id" string="Company"/>
                <field name="awb_sale_type" string="Sale Type"/>
                <field name="wrc_model" string="Model"/>
                <field name="wrc_brand" string="Brand"/>
                <field name="wrc_classification" string="Classification"/>
                <field name="wrc_payment_basis" string="Payment Basis"/>
                <field name="wrc_purchase_date" string="Date of Purchased"/>
                <field name="wrc_transferred" string="WRC Transferred"/>
                <field name="invoice_status" string="Invoice Status"/>
                
                <filter name="my_orders" string="My Orders"
                        domain="[('user_id', '=', uid)]"/>
                <filter name="sale_type_motorcycle" string="Motorcycle Only"
                        domain="[('awb_sale_type', '=', 'mc')]"/>
                
                <separator/>
                <filter name="fully_invoiced" string="Fully Invoiced"
                        domain="[('invoice_status', '=', 'invoiced')]"/>
                <filter name="to_invoice" string="To Invoice"
                        domain="[('invoice_status', '=', 'to invoice')]"/>
                <filter name="nothing_to_invoice" string="Nothing to Invoice"
                        domain="[('invoice_status', '=', 'no')]"/>
                <filter name="wrc_registered" string="WRC Registered"
                        domain="[('wrc_transferred', '=', True)]"/>
                <filter name="wrc_unregistered" string="WRC Unregistered"
                        domain="[('wrc_transferred', '=', False)]"/>
                
                <group expand="0" string="Group By">
                    <filter name="group_by_company" string="Company" domain="[]" context="{'group_by': 'company_id'}"/>
                    <filter name="group_by_sale_type" string="Sale Type" domain="[]" context="{'group_by': 'awb_sale_type'}"/>
                    <filter name="group_by_brand" string="Brand" domain="[]" context="{'group_by': 'wrc_brand'}"/>
                    <filter name="group_by_classification" string="Classification" domain="[]" context="{'group_by': 'wrc_classification'}"/>
                    <filter name="group_by_payment_basis" string="Payment Basis" domain="[]" context="{'group_by': 'wrc_payment_basis'}"/>
                    <filter name="group_by_invoice_status" string="Invoice Status" domain="[]" context="{'group_by': 'invoice_status'}"/>
                    <filter name="group_by_wrc_status" string="WRC Status" domain="[]" context="{'group_by': 'wrc_transferred'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Motorcycle Sales Action -->
    <record id="action_motorcycle_sales" model="ir.actions.act_window">
        <field name="name">Motorcycle Sales</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[
            ('awb_sale_type', '=', 'mc'),
            ('invoice_status', 'in', ['invoiced', 'to invoice', 'no'])
        ]</field>
        <field name="context">{
            'search_default_sale_type_motorcycle': 1,
            'default_awb_sale_type': 'mc',
        }</field>
        <field name="view_ids" eval="[(5, 0, 0),
                                      (0, 0, {'view_mode': 'tree', 'view_id': ref('view_motorcycle_sales_tree')}),
                                      (0, 0, {'view_mode': 'form', 'view_id': ref('view_motorcycle_sales_form_standalone')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No motorcycle sales found!
            </p>
            <p>
                This view shows motorcycle sales orders for WRC management.
                <br/>
                <br/>
                <b>Filtering Criteria:</b>
                <br/>
                • <strong>Sale Type:</strong> Only "Motorcycle" orders (not Labour or Spare Parts)
                <br/>
                • <strong>Invoice Status:</strong> Fully Invoiced, To Invoice, or Nothing to Invoice
                <br/>
                <br/>
                <b>Available Filters:</b>
                <br/>
                • "Fully Invoiced" - Orders that are completely paid
                <br/>
                • "To Invoice" - Orders ready for invoicing
                <br/>
                • "Nothing to Invoice" - Orders with no invoicing requirements
                <br/>
                • "WRC Registered/Unregistered" - Filter by WRC transfer status
                <br/>
                <br/>
                <b>Note:</b> This ensures only legitimate motorcycle sales are shown for WRC registration purposes.
            </p>
        </field>
    </record>

    <!-- Menu Items - Add to existing WRC Management menu -->
    
    <!-- Motorcycle Sales submenu -->
    <menuitem id="menu_motorcycle_sales" 
              name="Motorcycle Sales" 
              parent="menu_wrc_root"
              action="action_motorcycle_sales" 
              sequence="15"/>

</odoo>
