<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- WRC Record Tree View -->
    <record id="view_wrc_record_tree" model="ir.ui.view">
        <field name="name">wrc.record.tree</field>
        <field name="model">wrc.record</field>
        <field name="arch" type="xml">
            <tree>
                <field name="wrc_no"/>
                <field name="state"/>
                <field name="partner_id"/>
                <field name="sale_order_id"/>
                <field name="model"/>
                <field name="brand"/>
                <field name="classification"/>
                <field name="engine_no"/>
                <field name="frame_no"/>
                <field name="purchase_date"/>
                <field name="coupon_count"/>
            </tree>
        </field>
    </record>

    <!-- WRC Record Form View -->
    <record id="view_wrc_record_form" model="ir.ui.view">
        <field name="name">wrc.record.form</field>
        <field name="model">wrc.record</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Confirm" 
                            class="oe_highlight" attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button name="action_cancel" type="object" string="Cancel" 
                            attrs="{'invisible': [('state', 'in', ['cancelled', 'confirmed'])]}"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft" 
                            attrs="{'invisible': [('state', '=', 'draft')]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_coupons" type="object" class="oe_stat_button" icon="fa-ticket">
                            <field name="coupon_count" widget="statinfo" string="Service Coupons"/>
                        </button>
                    </div>
                    
                    <div class="oe_title">
                        <h1>
                            <field name="wrc_no" placeholder="WRC Number"/>
                        </h1>
                    </div>
                    
                    <!-- Sale Order Selection at the top -->
                    <group>
                        <group string="Sale Order Information">
                            <field name="sale_order_id" options="{'no_create': True, 'no_edit': True}"/>
                            <field name="purchase_date"/>
                            <field name="branch_id"/>
                        </group>
                        <group string="Customer Information">
                            <field name="partner_id"/>
                        </group>
                    </group>
                    
                    <group>
                        <group string="Customer Profile (Auto-filled)">
                            <field name="customer_name"/>
                            <field name="customer_address"/>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="birthday"/>
                            <field name="age"/>
                        </group>
                        <group string="Dealer Profile (Auto-filled)">
                            <field name="selling_dealer"/>
                            <field name="dealer_code"/>
                            <field name="dealer_address"/>
                        </group>
                    </group>
                    
                    <group>
                        <group string="Unit Information">
                            <field name="model" attrs="{'readonly': [('state', '=', 'confirmed')]}"/>
                            <field name="brand"/>
                            <field name="classification"/>
                            <field name="color" attrs="{'readonly': [('state', '=', 'confirmed')]}"/>
                            <field name="qty" attrs="{'readonly': [('state', '=', 'confirmed')]}"/>
                            <field name="payment_basis" attrs="{'readonly': [('state', '=', 'confirmed')]}"/>
                        </group>
                        <group string="Unit Numbers (Editable if incomplete)">
                            <field name="engine_no" attrs="{'readonly': [('state', '=', 'confirmed')]}"/>
                            <field name="frame_no" attrs="{'readonly': [('state', '=', 'confirmed')]}"/>
                        </group>
                    </group>
                    
                    <!-- Service Coupons Section -->
                    <notebook>
                        <page string="Service Coupons" name="service_coupons">
                            <field name="service_coupon_ids" readonly="1">
                                <tree decoration-warning="state == 'active' and is_overdue" 
                                      decoration-success="state == 'used'"
                                      decoration-muted="state in ['expired', 'disabled']">
                                    <field name="coupon_number"/>
                                    <field name="coupon_type"/>
                                    <field name="pms_km_min"/>
                                    <field name="pms_km_max"/>
                                    <field name="pms_months"/>
                                    <field name="due_date"/>
                                    <field name="state"/>
                                    <field name="is_overdue" invisible="1"/>
                                    <field name="actual_service_date"/>
                                    <field name="mileage"/>
                                    <button name="action_use_coupon" type="object" string="Use" 
                                            icon="fa-cog" attrs="{'invisible': [('can_use', '=', False)]}"/>
                                    <field name="can_use" invisible="1"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- WRC Record Search View -->
    <record id="view_wrc_record_search" model="ir.ui.view">
        <field name="name">wrc.record.search</field>
        <field name="model">wrc.record</field>
        <field name="arch" type="xml">
            <search>
                <field name="wrc_no"/>
                <field name="partner_id"/>
                <field name="sale_order_id"/>
                <field name="engine_no"/>
                <field name="frame_no"/>
                <field name="model"/>
                <field name="brand"/>
                <field name="classification"/>
                <separator/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter name="recent" string="Recent" domain="[('create_date', '&gt;=', (context_today() - datetime.timedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="commuter" string="Commuter" domain="[('classification', '=', 'commuter')]"/>
                <filter name="bigbike" string="BigBike" domain="[('classification', '=', 'bigbike')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_customer" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_sale_order" string="Sale Order" context="{'group_by': 'sale_order_id'}"/>
                    <filter name="group_model" string="Model" context="{'group_by': 'model'}"/>
                    <filter name="group_brand" string="Brand" context="{'group_by': 'brand'}"/>
                    <filter name="group_classification" string="Classification" context="{'group_by': 'classification'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_date" string="Purchase Date" context="{'group_by': 'purchase_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- WRC Record Action -->
    <record id="action_wrc_record" model="ir.actions.act_window">
        <field name="name">WRC Records</field>
        <field name="res_model">wrc.record</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_wrc_record_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first WRC Record!
            </p>
            <p>
                WRC Records track motorcycle sales information with automated coupon management.
                Records are automatically created when motorcycle sales are fully invoiced.
            </p>
        </field>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_wrc_root" name="WRC Management" sequence="10"/>
    <menuitem id="menu_wrc_records" name="WRC Records" parent="menu_wrc_root" action="action_wrc_record" sequence="10"/>
</odoo>