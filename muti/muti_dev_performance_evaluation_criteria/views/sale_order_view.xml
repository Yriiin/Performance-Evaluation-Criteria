<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Working WRC Integration for Sale Order -->
    <record id="view_sale_order_working_wrc" model="ir.ui.view">
        <field name="name">sale.order.working.wrc</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Add WRC button to button_box -->
            <div name="button_box" position="inside">
                <button name="action_view_wrc" type="object" class="oe_stat_button" icon="fa-id-card" attrs="{'invisible': [('has_wrc', '=', False)]}">
                    <field name="wrc_count" widget="statinfo" string="WRC Record"/>
                </button>
            </div>
            
            <!-- Add WRC notebook tab - Only show for Motorcycle sales -->
            <notebook position="inside">
                <!-- WRC Information Tab - Show for motorcycle sales -->
                <page string="WRC Information" name="wrc_information" 
                      attrs="{'invisible': [('is_mc_sale', '=', False)]}">
                    
                    <!-- Add invisible trigger fields -->
                    <field name="wrc_tab_trigger" invisible="1"/>
                    <field name="wrc_trigger" invisible="1"/>
                    
                    <!-- EDITABLE FORM: Show when NO WRC record exists -->
                    <div attrs="{'invisible': [('has_wrc', '=', True)]}">
                        
                        <!-- Sale Order Information (Auto-filled) -->
                        <separator string="Sale Order Information"/>
                        <group>
                            <group string="Sale Order Details">
                                <field name="name" string="Sale Order" readonly="1"/>
                                <field name="date_order" readonly="1"/>
                                <field name="partner_id" string="Customer" readonly="1"/>
                            </group>
                            <group string="WRC Status">
                                <field name="wrc_sale_type" readonly="1"/>
                                <field name="is_mc_sale" readonly="1"/>
                                <field name="has_wrc" readonly="1"/>
                                <field name="state" readonly="1"/>
                            </group>
                        </group>
                        
                        <!-- Customer Information -->
                        <separator string="Customer Information"/>
                        <group>
                            <group string="Customer Details">
                                <field name="wrc_address" string="Customer Address" 
                                       placeholder="Auto-populated from customer record"/>
                                <field name="wrc_phone" string="Contact #" 
                                       placeholder="Auto-populated from customer phone/mobile"/>
                            </group>
                            <group string="Personal Information">
                                <field name="wrc_birthdate" string="Birthdate" 
                                       placeholder="Auto-populated if available"/>
                                <field name="wrc_age" string="Age" readonly="1"/>
                                <field name="wrc_sex" string="Sex" 
                                       placeholder="Auto-populated if available"/>
                            </group>
                        </group>
                        
                        <!-- Dealer Information -->
                        <separator string="Dealer Information"/>
                        <group>
                            <group string="Dealer Details">
                                <field name="wrc_dealer_code" string="Dealers Code" 
                                       placeholder="Auto-populated from dealer info"/>
                                <field name="wrc_dealer" string="Dealer" 
                                       placeholder="Auto-populated from dealer info"/>
                                <field name="wrc_dealer_address" string="Address of Dealer" 
                                       placeholder="Auto-populated from dealer info"/>
                            </group>
                        </group>
                        
                        <!-- Motorcycle Details -->
                        <separator string="Motorcycle Details"/>
                        <group>
                            <group string="Identification Numbers">
                                <field name="wrc_engine" string="Engine Number" 
                                       placeholder="Auto-populated from delivery operations"/>
                                <field name="wrc_frame" string="Frame Number" 
                                       placeholder="Auto-populated from delivery operations"/>
                            </group>
                            <group string="Motorcycle Specifications">
                                <field name="wrc_model" string="Model" 
                                       placeholder="Auto-populated from product name"/>
                                <field name="wrc_color" string="Color" 
                                       placeholder="Auto-populated from product name"/>
                                <field name="wrc_purchase_date" string="Date of Purchase" 
                                       placeholder="Auto-populated from delivery effective date"/>
                            </group>
                        </group>
                        
                        <!-- Service Coupon Codes -->
                        <separator string="Service Coupon Codes"/>
                        <group>
                            <group string="Primary Service Coupons">
                                <field name="wrc_coupon_1" placeholder="Enter first coupon code"/>
                                <field name="wrc_coupon_2" placeholder="Enter second coupon code"/>
                                <field name="wrc_coupon_3" placeholder="Enter third coupon code"/>
                            </group>
                            <group string="Additional Coupon Codes (if more than 3)">
                                <field name="wrc_coupons_extra" placeholder="Enter additional coupon codes (one per line)" nolabel="1"/>
                            </group>
                        </group>

                        <!-- Save Button -->
                        <div class="row mt-3">
                            <div class="col-12 text-center">
                                <button name="action_save_wrc" 
                                        type="object" 
                                        string="Save WRC Record" 
                                        class="btn-primary btn-lg"
                                        help="Save WRC record with current form data"/>
                            </div>
                        </div>
                    </div>
                    
                    <!-- READ-ONLY FORM: Show when WRC record exists (FROZEN STATE) -->
                    <div attrs="{'invisible': [('has_wrc', '=', False)]}">
                        
                        <!-- WRC Record Header -->
                        <div class="oe_title mb-3">
                            <h2 class="text-primary">
                                <i class="fa fa-id-card"/> WRC Record Details
                            </h2>
                            <div class="text-muted">
                                <strong>WRC No.:</strong> 
                                <field name="wrc_records" widget="many2one" readonly="1" options="{'no_open': True}" nolabel="1"/>
                            </div>
                        </div>
                        
                        <!-- Sale Order Information (Read-only) -->
                        <separator string="Sale Order Information"/>
                        <group>
                            <group string="Sale Order Details">
                                <field name="name" string="Sale Order" readonly="1"/>
                                <field name="date_order" readonly="1"/>
                                <field name="partner_id" string="Customer" readonly="1"/>
                            </group>
                            <group string="WRC Status">
                                <field name="wrc_sale_type" readonly="1"/>
                                <field name="has_wrc" readonly="1"/>
                                <field name="wrc_count" readonly="1"/>
                            </group>
                        </group>
                        
                        <!-- Customer Information (Read-only) -->
                        <separator string="Customer Information"/>
                        <group>
                            <group string="Customer Details">
                                <field name="wrc_address" string="Customer Address" readonly="1"/>
                                <field name="wrc_phone" string="Contact #" readonly="1"/>
                            </group>
                            <group string="Personal Information">
                                <field name="wrc_birthdate" string="Birthdate" readonly="1"/>
                                <field name="wrc_age" string="Age" readonly="1"/>
                                <field name="wrc_sex" string="Sex" readonly="1"/>
                            </group>
                        </group>
                        
                        <!-- Dealer Information (Read-only) -->
                        <separator string="Dealer Information"/>
                        <group>
                            <group string="Dealer Details">
                                <field name="wrc_dealer_code" string="Dealers Code" readonly="1"/>
                                <field name="wrc_dealer" string="Dealer" readonly="1"/>
                                <field name="wrc_dealer_address" string="Address of Dealer" readonly="1"/>
                            </group>
                        </group>
                        
                        <!-- Motorcycle Details (Read-only) -->
                        <separator string="Motorcycle Details"/>
                        <group>
                            <group string="Identification Numbers">
                                <field name="wrc_engine" string="Engine Number" readonly="1"/>
                                <field name="wrc_frame" string="Frame Number" readonly="1"/>
                            </group>
                            <group string="Motorcycle Specifications">
                                <field name="wrc_model" string="Model" readonly="1"/>
                                <field name="wrc_color" string="Color" readonly="1"/>
                                <field name="wrc_purchase_date" string="Date of Purchase" readonly="1"/>
                            </group>
                        </group>
                        
                        <!-- Service Coupon Codes (Read-only) -->
                        <separator string="Service Coupon Codes"/>
                        <group>
                            <group string="Service Coupon 1">
                                <field name="wrc_coupon_1" readonly="1"/>
                            </group>
                            <group string="Service Coupon 2">
                                <field name="wrc_coupon_2" readonly="1"/>
                            </group>
                        </group>
                        <group>
                            <group string="Service Coupon 3">
                                <field name="wrc_coupon_3" readonly="1"/>
                            </group>
                            <group string="Additional Coupons" attrs="{'invisible': [('wrc_coupons_extra', '=', False)]}">
                                <field name="wrc_coupons_extra" readonly="1"/>
                            </group>
                        </group>
                        
                        <!-- Quick Action Buttons -->
                        <div class="row mt-3">
                            <div class="col-12 text-center">
                                <button name="action_view_wrc" 
                                        type="object" 
                                        string="Open Full WRC Record" 
                                        class="btn-primary"
                                        help="Open the complete WRC record form"/>
                            </div>
                        </div>
                        
                        <!-- Info message -->
                        <div class="mt-3 text-center">
                            <p class="text-muted">
                                <i class="fa fa-info-circle"/> WRC information is locked to maintain data integrity. 
                                Use "Open Full WRC Record" to make changes if necessary.
                            </p>
                        </div>
                    </div>
                </page>
            </notebook>
        </field>
    </record>
</odoo>