<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Root Menu for WRC Management -->
    <menuitem id="menu_wrc_root" name="WRC Management" sequence="10"/>
    
    <!-- WRC Coupon Line Tree View for better display -->
    <record id="view_wrc_coupon_line_tree" model="ir.ui.view">
        <field name="name">wrc.record.coupon.line.tree</field>
        <field name="model">wrc.record.coupon.line</field>
        <field name="arch" type="xml">
            <tree editable="bottom" create="true" delete="true" class="o_list_view_table_full_width">
                <field name="coupon_number" string="Coupon Number" required="1"/>
                <field name="coupon_type" string="Type" required="1"/>
                <field name="pms_km_min" string="Min KM"/>
                <field name="pms_km_max" string="Max KM"/>
                <field name="pms_months" string="Months"/>
                <field name="notes" string="Notes"/>
            </tree>
        </field>
    </record>
    
    <!-- WRC Record Tree View -->
    <record id="view_wrc_record_tree" model="ir.ui.view">
        <field name="name">wrc.record.tree</field>
        <field name="model">wrc.record</field>
        <field name="arch" type="xml">
            <tree>
                <field name="wrc_no"/>
                <field name="state"/>
                <field name="partner_id"/>
                <field name="sale_order_id"/>
                <field name="model"/>
                <field name="brand"/>
                <field name="classification"/>
                <field name="engine_no"/>
                <field name="frame_no"/>
                <field name="purchase_date"/>
                <field name="coupon_count" string="Coupons"/>
            </tree>
        </field>
    </record>

    <!-- WRC Record Form View -->
    <record id="view_wrc_record_form" model="ir.ui.view">
        <field name="name">wrc.record.form</field>
        <field name="model">wrc.record</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary" 
                            attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button name="action_cancel" string="Cancel" type="object" 
                            attrs="{'invisible': [('state', '=', 'cancelled')]}"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object" 
                            attrs="{'invisible': [('state', '!=', 'confirmed')]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_coupons" type="object" class="oe_stat_button" icon="fa-tags">
                            <field name="coupon_count" widget="statinfo" string="Service Coupons"/>
                        </button>
                    </div>
                    
                    <div class="oe_title">
                        <h1>
                            <field name="wrc_no" placeholder="Enter WRC Number" attrs="{'readonly': [('state', '=', 'confirmed')]}"/>
                        </h1>
                    </div>
                    
                    <!-- Sale Order Selection at the top -->
                    <group>
                        <group string="Sale Order Information">
                            <field name="sale_order_id" options="{'no_create': True, 'no_edit': True}" 
                                   attrs="{'readonly': [('state', '=', 'confirmed')]}"/>
                            <field name="purchase_date" attrs="{'readonly': [('state', '=', 'confirmed')]}"/>
                            <field name="branch_id" attrs="{'readonly': [('state', '=', 'confirmed')]}"/>
                        </group>
                        <group string="Customer Information">
                            <field name="partner_id" attrs="{'readonly': [('state', '=', 'confirmed')]}"/>
                        </group>
                    </group>
                    
                    <group>
                        <group string="Customer Profile">
                            <field name="customer_name" attrs="{'readonly': ['|', ('state', '=', 'confirmed'), ('customer_name', '!=', False)]}"/>
                            <field name="customer_address" attrs="{'readonly': ['|', ('state', '=', 'confirmed'), ('customer_address', '!=', False)]}"/>
                            <field name="phone" attrs="{'readonly': ['|', ('state', '=', 'confirmed'), ('phone', '!=', False)]}"/>
                            <field name="email" attrs="{'readonly': ['|', ('state', '=', 'confirmed'), ('email', '!=', False)]}"/>
                            <field name="birthday" attrs="{'readonly': ['|', ('state', '=', 'confirmed'), ('birthday', '!=', False)]}"/>
                            <field name="age" attrs="{'readonly': True}"/>
                        </group>
                        <group string="Dealer Profile">
                            <field name="selling_dealer" attrs="{'readonly': ['|', ('state', '=', 'confirmed'), ('selling_dealer', '!=', False)]}"/>
                            <field name="dealer_code" attrs="{'readonly': ['|', ('state', '=', 'confirmed'), ('dealer_code', '!=', False)]}"/>
                            <field name="dealer_address" attrs="{'readonly': ['|', ('state', '=', 'confirmed'), ('dealer_address', '!=', False)]}"/>
                        </group>
                    </group>
                    
                    <group>
                        <group string="Unit Information">
                            <field name="state" invisible="1"/>
                            <field name="model" attrs="{'readonly': ['|', ('state', '=', 'confirmed'), ('model', '!=', False)]}"/>
                            <field name="brand" attrs="{'readonly': [('brand', '!=', False)]}"/>
                            <field name="classification" widget="selection" attrs="{'readonly': [('classification', '!=', False)]}"/>
                            <field name="color" attrs="{'readonly': ['|', ('state', '=', 'confirmed'), ('color', '!=', False)]}"/>
                            <field name="qty" attrs="{'readonly': ['|', ('state', '=', 'confirmed'), ('qty', '>', 0)]}"/>
                            <field name="payment_basis" attrs="{'readonly': ['|', ('state', '=', 'confirmed'), ('payment_basis', '!=', False)]}"/>
                            <field name="purchase_date" attrs="{'readonly': [('purchase_date', '!=', False)]}"/>
                        </group>
                        <group string="Unit Numbers">
                            <field name="engine_no" attrs="{'readonly': ['|', ('state', '=', 'confirmed'), ('engine_no', '!=', False)]}"/>
                            <field name="frame_no" attrs="{'readonly': ['|', ('state', '=', 'confirmed'), ('frame_no', '!=', False)]}"/>
                        </group>
                    </group>
                    
                    <!-- Coupon Registration Lines -->
                    <group string="Coupon Registration" col="1">
                        <div class="alert alert-warning" role="alert" attrs="{'invisible': [('state', '!=', 'draft')]}">
                            <strong>Note:</strong> Service coupons will be created when this WRC record is confirmed.
                            <button name="action_confirm" type="object" class="btn btn-sm btn-primary ml-2"
                                    attrs="{'invisible': [('state', '!=', 'draft')]}">
                                <i class="fa fa-check"/> Confirm &amp; Create Service Coupons
                            </button>
                            <button name="action_create_service_coupons" type="object" class="btn btn-sm btn-success ml-1"
                                    attrs="{'invisible': [('state', '!=', 'draft')]}">
                                <i class="fa fa-plus"/> Create Service Coupons Only
                            </button>
                        </div>
                        <div class="alert alert-success" role="alert" 
                             attrs="{'invisible': ['|', ('state', '=', 'draft'), ('coupon_count', '=', 0)]}">
                            <strong>Service Coupons Created:</strong> <field name="coupon_count"/> service coupons are available in the Service Coupons tab.
                        </div>
                        <field name="coupon_line_ids" 
                               widget="one2many" context="{'tree_view_ref': 'muti_dev_performance_evaluation_criteria.view_wrc_coupon_line_tree'}">
                            <tree editable="bottom" create="true" delete="true" decoration-info="True">
                                <field name="coupon_number" string="Coupon Number" width="150px"/>
                                <field name="coupon_type" string="Type" width="250px"/>
                                <field name="pms_km_min" string="Min KM" width="80px"/>
                                <field name="pms_km_max" string="Max KM" width="80px"/>
                                <field name="pms_months" string="Months" width="80px"/>
                                <field name="notes" string="Notes"/>
                            </tree>
                        </field>
                    </group>
                    
                    <!-- Service Coupons Section -->
                    <notebook>
                        <page string="Service Coupons" name="service_coupons">
                            <field name="service_coupon_ids" readonly="1">
                                <tree decoration-warning="state == 'active' and is_overdue" 
                                      decoration-success="state == 'used'" 
                                      decoration-muted="state == 'disabled'">
                                    <field name="coupon_number"/>
                                    <field name="coupon_type"/>
                                    <field name="state"/>
                                    <field name="due_date"/>
                                    <field name="date_used"/>
                                    <field name="is_overdue" invisible="1"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- WRC Record Search View -->
    <record id="view_wrc_record_search" model="ir.ui.view">
        <field name="name">wrc.record.search</field>
        <field name="model">wrc.record</field>
        <field name="arch" type="xml">
            <search>
                <field name="wrc_no"/>
                <field name="partner_id"/>
                <field name="sale_order_id"/>
                <field name="engine_no"/>
                <field name="frame_no"/>
                <field name="model"/>
                <field name="brand"/>
                <field name="classification"/>
                <separator/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter name="recent" string="Recent" domain="[('create_date', '&gt;=', (context_today() - datetime.timedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="commuter" string="Commuter" domain="[('classification', '=', 'commuter')]"/>
                <filter name="bigbike" string="BigBike" domain="[('classification', '=', 'bigbike')]"/>
                <separator/>
                <filter name="honda_brand" string="Honda" domain="[('brand', '=', 'honda')]"/>
                <filter name="has_coupons" string="Has Coupons" domain="[('coupon_count', '>', 0)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_customer" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_sale_order" string="Sale Order" context="{'group_by': 'sale_order_id'}"/>
                    <filter name="group_model" string="Model" context="{'group_by': 'model'}"/>
                    <filter name="group_brand" string="Brand" context="{'group_by': 'brand'}"/>
                    <filter name="group_classification" string="Classification" context="{'group_by': 'classification'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_date" string="Purchase Date" context="{'group_by': 'purchase_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- WRC Record Action -->
    <record id="action_wrc_record" model="ir.actions.act_window">
        <field name="name">WRC Records</field>
        <field name="res_model">wrc.record</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_wrc_record_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first WRC Record!
            </p>
            <p>
                WRC Records track motorcycle sales information with automated coupon management.
                Records are automatically created when motorcycle sales are fully invoiced.
            </p>
        </field>
    </record>

    <!-- Cleanup Duplicates Server Action -->
    <record id="action_cleanup_duplicate_wrc" model="ir.actions.server">
        <field name="name">Cleanup Duplicate WRC Records</field>
        <field name="model_id" ref="model_wrc_record"/>
        <field name="state">code</field>
        <field name="code">
result = env['wrc.record'].cleanup_duplicate_wrc_records()
action = {
    'type': 'ir.actions.client',
    'tag': 'display_notification',
    'params': {
        'title': 'Cleanup Complete',
        'message': result['message'],
        'type': 'success' if result['duplicates_removed'] > 0 else 'info',
        'sticky': True,
    }
}
        </field>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_wrc_records" name="WRC Records" parent="menu_wrc_root" action="action_wrc_record" sequence="10"/>
    <menuitem id="menu_cleanup_duplicates" name="Cleanup Duplicates" parent="menu_wrc_root" action="action_cleanup_duplicate_wrc" sequence="99"/>
</odoo>
