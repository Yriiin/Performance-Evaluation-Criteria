<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- WRC Header View - Hidden redundant buttons, keeping only necessary fields -->
    <record id="view_sale_order_wrc_header" model="ir.ui.view">
        <field name="name">sale.order.wrc.header</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Add required fields for attrs conditions -->
            <field name="state" position="after">
                <field name="awb_sale_type" invisible="1"/>
                <field name="show_wrc" invisible="1"/>
                <field name="wrc_transferred" invisible="1"/>
            </field>
        </field>
    </record>
</odoo>
