<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- WRC Record Tree View -->
    <record id="view_wrc_record_tree" model="ir.ui.view">
        <field name="name">wrc.record.tree</field>
        <field name="model">wrc.record</field>
        <field name="arch" type="xml">
            <tree>
                <field name="wrc_no"/>
                <field name="partner_id"/>
                <field name="sale_order_id"/>
                <field name="engine_number"/>
                <field name="frame_number"/>
                <field name="model"/>
                <field name="color"/>
                <field name="date_of_purchase"/>
            </tree>
        </field>
    </record>

    <!-- WRC Record Form View - SERVICE INFORMATION REMOVED -->
    <record id="view_wrc_record_form" model="ir.ui.view">
        <field name="name">wrc.record.form</field>
        <field name="model">wrc.record</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="wrc_no" placeholder="WRC Number"/>
                        </h1>
                    </div>
                    
                    <!-- Sale Order Selection at the top -->
                    <group>
                        <group string="Sale Order Information">
                            <field name="sale_order_id" options="{'no_create': True, 'no_edit': True}"/>
                            <field name="date_of_purchase"/>
                        </group>
                        <group string="Branch Information">
                            <field name="branch_id"/>
                        </group>
                    </group>
                    
                    <group>
                        <group string="Customer Information">
                            <field name="partner_id"/>
                            <field name="customer_address"/>
                            <field name="contact_number"/>
                        </group>
                        <group string="Personal Information">
                            <field name="birthdate"/>
                            <field name="age"/>
                            <field name="sex"/>
                        </group>
                    </group>
                    
                    <group>
                        <group string="Dealer Information">
                            <field name="dealers_code"/>
                            <field name="dealer"/>
                            <!-- Removed servicing_branch field -->
                            <field name="dealer_address"/>
                        </group>
                        <group string="Motorcycle Details">
                            <field name="engine_number"/>
                            <field name="frame_number"/>
                            <field name="model"/>
                            <field name="color"/>
                        </group>
                    </group>
                    
                    <!-- Service Coupon Codes - Keep as text field for reference -->
                    <group>
                        <group string="Service Coupon Codes">
                            <field name="coupon_codes" placeholder="Enter coupon codes (one per line)" nolabel="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- WRC Record Search View -->
    <record id="view_wrc_record_search" model="ir.ui.view">
        <field name="name">wrc.record.search</field>
        <field name="model">wrc.record</field>
        <field name="arch" type="xml">
            <search>
                <field name="wrc_no"/>
                <field name="partner_id"/>
                <field name="sale_order_id"/>
                <field name="engine_number"/>
                <field name="frame_number"/>
                <field name="model"/>
                <separator/>
                <filter name="recent" string="Recent" domain="[('create_date', '&gt;=', (context_today() - datetime.timedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_customer" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_sale_order" string="Sale Order" context="{'group_by': 'sale_order_id'}"/>
                    <filter name="group_model" string="Model" context="{'group_by': 'model'}"/>
                    <filter name="group_date" string="Purchase Date" context="{'group_by': 'date_of_purchase'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- WRC Record Action -->
    <record id="action_wrc_record" model="ir.actions.act_window">
        <field name="name">WRC Records</field>
        <field name="res_model">wrc.record</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_wrc_record_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first WRC Record!
            </p>
            <p>
                WRC Records track motorcycle sales information. 
                Select a Sale Order to automatically populate customer and motorcycle details.
            </p>
        </field>
    </record>
</odoo>