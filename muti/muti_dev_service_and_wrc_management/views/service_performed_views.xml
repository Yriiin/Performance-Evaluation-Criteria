<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Service Performed Tree View -->
    <record id="view_service_performed_tree" model="ir.ui.view">
        <field name="name">service.performed.tree</field>
        <field name="model">service.performed</field>
        <field name="arch" type="xml">
            <tree decoration-info="state=='draft'" decoration-warning="state=='in_progress'" decoration-success="state=='completed'" decoration-muted="state=='cancelled'">
                <field name="name"/>
                <field name="pms_id"/>
                <field name="service_type"/>
                <field name="wrc_record_id"/>
                <field name="service_coupon_id"/>
                <field name="service_date"/>
                <field name="servicing_branch_id"/>
                <field name="mileage"/>
                <field name="mechanic_id"/>
                <field name="cost"/>
                <field name="labor_hours"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <!-- Service Performed Form View -->
    <record id="view_service_performed_form" model="ir.ui.view">
        <field name="name">service.performed.form</field>
        <field name="model">service.performed</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start_service" type="object" string="Start Service" class="btn-warning" attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button name="action_complete_service" type="object" string="Complete Service" class="btn-success" attrs="{'invisible': [('state', '!=', 'in_progress')]}"/>
                    <button name="action_cancel_service" type="object" string="Cancel Service" class="btn-secondary" attrs="{'invisible': [('state', 'in', ['completed', 'cancelled'])]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group string="PMS Information">
                            <field name="pms_id"/>
                            <field name="wrc_record_id"/>
                            <field name="service_coupon_id"/>
                        </group>
                        <group string="Service Information">
                            <field name="service_type"/>
                            <field name="servicing_branch_id"/>
                            <field name="service_date"/>
                            <field name="mileage"/>
                            <field name="mechanic_id"/>
                        </group>
                    </group>
                    
                    <group>
                        <group string="Cost and Time">
                            <field name="cost"/>
                            <field name="labor_hours"/>
                            <field name="warranty_period"/>
                        </group>
                    </group>
                    
                    <group string="Service Description">
                        <field name="service_description" placeholder="Describe the specific service performed" nolabel="1"/>
                    </group>
                    
                    <group string="Parts Replaced">
                        <field name="parts_replaced" placeholder="List specific parts that were replaced" nolabel="1"/>
                    </group>
                    
                    <group string="Additional Notes">
                        <field name="notes" placeholder="Any additional notes or observations" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Service Performed Search View -->
    <record id="view_service_performed_search" model="ir.ui.view">
        <field name="name">service.performed.search</field>
        <field name="model">service.performed</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="pms_id"/>
                <field name="wrc_record_id"/>
                <field name="service_coupon_id"/>
                <field name="service_type"/>
                <field name="mechanic_id"/>
                <separator/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="in_progress" string="In Progress" domain="[('state', '=', 'in_progress')]"/>
                <filter name="completed" string="Completed" domain="[('state', '=', 'completed')]"/>
                <filter name="today" string="Today" domain="[('service_date', '=', context_today())]"/>
                <filter name="this_month" string="This Month" domain="[('service_date', '&gt;=', (context_today().replace(day=1)).strftime('%Y-%m-%d')), ('service_date', '&lt;', ((context_today().replace(day=1) + relativedelta(months=1)).strftime('%Y-%m-%d')))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_pms" string="PMS Reference" context="{'group_by': 'pms_id'}"/>
                    <filter name="group_service_type" string="Service Type" context="{'group_by': 'service_type'}"/>
                    <filter name="group_wrc" string="WRC Record" context="{'group_by': 'wrc_record_id'}"/>
                    <filter name="group_branch" string="Servicing Branch" context="{'group_by': 'servicing_branch_id'}"/>
                    <filter name="group_mechanic" string="Mechanic" context="{'group_by': 'mechanic_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_date" string="Service Date" context="{'group_by': 'service_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Service Performed Action -->
    <record id="action_service_performed" model="ir.actions.act_window">
        <field name="name">Services Performed</field>
        <field name="res_model">service.performed</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_service_performed_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Service Performed record!
            </p>
            <p>
                Track individual services performed during preventive maintenance.
                This helps maintain detailed service history for each motorcycle.
            </p>
        </field>
    </record>
</odoo>